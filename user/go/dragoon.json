{
  "llvm-target": "i386-unknown-none-elf",
  "cpu": "i686",
  "features": "-mmx,-sse,-sse2,-sse3,-ssse3,-sse4.1,-sse4.2,-avx,-avx2",
  "build-tags": ["dragoon", "baremetal"],
  "goos": "linux",
  "goarch": "386",
  "gc": "conservative",
  "scheduler": "none",
  "linker": "ld.lld",
  "rtlib": "compiler-rt",
  "automatic-stack-size": false,
  "default-stack-size": 16384,
  "cflags": [
    "-m32",
    "-ffreestanding",
    "-fno-pic",
    "-fno-pie",
    "-fno-stack-protector",
    "-mno-sse",
    "-mno-mmx"
  ],
  "ldflags": [
    "-m",
    "elf_i386",
    "-no-pie",
    "-T",
    "/home/dragoon/coding/os/user/linker.ld"
  ],
  "extra-files": ["runtime_dragoon.c", "src/runtime/asm_386.S"]
}
